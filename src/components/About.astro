---
import Avatar from "@/assets/avatar.svg";
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import { siteConfig } from "@/lib/site.config";
---

<Card>
  <CardHeader>
    <div class="relative flex items-center gap-x-4">
      <Avatar class="size-12 rounded-full fill-black dark:fill-white" />
      <p class="text-sm font-semibold leading-6 text-primary">{siteConfig.name}</p>
    </div>
  </CardHeader>
  <CardContent>
    <p
      class="text-2xl font-medium tracking-tight text-primary md:text-4xl lg:text-4xl"
    >
      Hello, world!
    </p>
    <p class="mt-4 text-sm font-light text-muted-foreground lg:text-xl">
      Welcome to my portfolio template built with Astro, React, and Tailwind CSS.
      <br />
      <br />
      {siteConfig.description}
    </p>
  </CardContent>
</Card>
